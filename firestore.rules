rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidMediaSource(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.url is string && data.url.size() >= 4 && data.url.size() <= 1200 &&
             data.sourceType in ['CHANNEL', 'PLAYLIST_M3U', 'WEBSITE', 'DIRECT_MOVIE'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1200)) &&
             data.channelCount is int && data.channelCount >= 0 && data.channelCount <= 50000;
    }

    function isValidLibraryItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.streamUrl is string && data.streamUrl.size() >= 4 && data.streamUrl.size() <= 1200 &&
             (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 1200)) &&
             data.sourceName is string && data.sourceName.size() >= 1 && data.sourceName.size() <= 100 &&
             data.mediaType in ['MOVIE', 'LIVE_CHANNEL', 'WEB_VIDEO'] &&
             data.favorite is bool &&
             data.lastPositionMs is int && data.lastPositionMs >= 0 &&
             data.durationMs is int && data.durationMs >= 0 &&
             (!('lastWatchedAt' in data) || (data.lastWatchedAt is timestamp && data.lastWatchedAt <= request.time));
    }

    match /users/{userId}/sources/{sourceId} {
      allow get: if isOwner(userId) && isValidId(sourceId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(sourceId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'url', 'sourceType', 'category', 'channelCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'url', 'sourceType', 'category', 'logoUrl', 'channelCount', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidMediaSource(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(sourceId) &&
                       isValidMediaSource(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'sourceType', 'category', 'logoUrl', 'channelCount', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(sourceId);
    }

    match /users/{userId}/library/{itemId} {
      allow get: if isOwner(userId) && isValidId(itemId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(itemId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'streamUrl', 'sourceName', 'mediaType', 'favorite', 'lastPositionMs', 'durationMs', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'streamUrl', 'posterUrl', 'sourceName', 'mediaType', 'favorite', 'lastPositionMs', 'durationMs', 'lastWatchedAt', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidLibraryItem(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(itemId) &&
                       isValidLibraryItem(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'streamUrl', 'posterUrl', 'sourceName', 'mediaType', 'favorite', 'lastPositionMs', 'durationMs', 'lastWatchedAt', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(itemId);
    }
  }
}
